   838                                  ; ==========================================
   839                                  ; WAIT FOR KEY
   840                                  ; ==========================================
   841                                  
   842 00000A3C 30E4                        xor ah,ah
   843 00000A3E CD16                        int 16h
   844                                  
   845                                      ; Restore text mode
   846 00000A40 B80300                      mov ax,0003h
   847 00000A43 CD10                        int 10h
   848                                  
   849                                      ; Exit
   850 00000A45 B8004C                      mov ax,4C00h
   851 00000A48 CD21                        int 21h
