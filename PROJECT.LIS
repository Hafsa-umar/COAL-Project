   854                                  ; ==========================================
   855                                  ; DRAW RECTANGLE ROUTINE
   856                                  ; ==========================================
   857                                  
   858                                  drawRect:
   859                                  
   860 00000A4A 50                          push ax
   861 00000A4B 53                          push bx
   862 00000A4C 51                          push cx
   863 00000A4D 52                          push dx
   864 00000A4E 56                          push si
   865 00000A4F 57                          push di
   866 00000A50 06                          push es
   867                                  
   868 00000A51 B800A0                      mov ax,0A000h
   869 00000A54 8EC0                        mov es,ax
   870                                  
   871 00000A56 FC                          cld
   872                                  
   873                                      ; Clip rectangle to screen width
   874 00000A57 A1[0300]                    mov ax,[x]
   875 00000A5A 0306[0700]                  add ax,[w]
   876                                  
   877 00000A5E 3D4001                      cmp ax,320
   878 00000A61 760A                        jbe widthOK
   879                                  
   880 00000A63 B84001                      mov ax,320
   881 00000A66 2B06[0300]                  sub ax,[x]
   882 00000A6A A3[0700]                    mov [w],ax
   883                                  
   884                                  widthOK:
   885                                  
   886                                      ; Keep row count separate from DX
   887 00000A6D A1[0900]                    mov ax,[h]
   888 00000A70 A3[0C00]                    mov [rowCount],ax
   889                                  
   890 00000A73 8B36[0500]                  mov si,[y]
   891                                  
   892                                  rectRow:
   893                                  
   894                                      ; Calculate screen offset
   895 00000A77 89F0                        mov ax,si
   896 00000A79 BB4001                      mov bx,320
   897 00000A7C F7E3                        mul bx
   898                                  
   899 00000A7E 0306[0300]                  add ax,[x]
   900 00000A82 89C7                        mov di,ax
   901                                  
   902                                      ; Draw one row
   903 00000A84 A0[0B00]                    mov al,[color]
   904 00000A87 8B0E[0700]                  mov cx,[w]
   905                                  
   906 00000A8B F3AA                        rep stosb
   907                                  
   908 00000A8D 46                          inc si
   909                                  
   910 00000A8E FF0E[0C00]                  dec word [rowCount]
   911 00000A92 75E3                        jnz rectRow
   912                                  
   913 00000A94 07                          pop es
   914 00000A95 5F                          pop di
   915 00000A96 5E                          pop si
   916 00000A97 5A                          pop dx
   917 00000A98 59                          pop cx
   918 00000A99 5B                          pop bx
   919 00000A9A 58                          pop ax
   920                                  
   921 00000A9B C3                          ret
   922                                  
