   924                                  ; ==========================================
   925                                  ; PRINT TEXT ROUTINE
   926                                  ; ==========================================
   927                                  
   928                                  printText:
   929                                  
   930 00000A9C 50                          push ax
   931 00000A9D 53                          push bx
   932 00000A9E 52                          push dx
   933 00000A9F 56                          push si
   934                                  
   935 00000AA0 B402                        mov ah,02h
   936 00000AA2 B700                        mov bh,0
   937 00000AA4 CD10                        int 10h
   938                                  
   939                                  printLoop:
   940                                  
   941 00000AA6 AC                          lodsb
   942                                  
   943 00000AA7 3C00                        cmp al,0
   944 00000AA9 740A                        je printDone
   945                                  
   946 00000AAB B40E                        mov ah,0Eh
   947 00000AAD B700                        mov bh,0
   948 00000AAF B30F                        mov bl,0Fh
   949                                  
   950 00000AB1 CD10                        int 10h
   951                                  
   952 00000AB3 EBF1                        jmp printLoop
   953                                  
   954                                  printDone:
   955                                  
   956 00000AB5 5E                          pop si
   957 00000AB6 5A                          pop dx
   958 00000AB7 5B                          pop bx
   959 00000AB8 58                          pop ax
   960                                  
   961 00000AB9 C3                          ret
